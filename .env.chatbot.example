# Chatbot Service environment variables
# Copy ke .env.chatbot dan sesuaikan, lalu jalankan:
#   uvicorn chatbot_service.main:app --port 8001 --env-file .env.chatbot

# === vLLM endpoint (port 8002) ===
VLLM_BASE_URL=http://localhost:8002/v1
VLLM_API_KEY=EMPTY
CHATBOT_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct

# === Dashboard callback (port 8000) ===
DASHBOARD_BASE_URL=http://localhost:8000
DASHBOARD_API_KEY=

# === Service port ===
CHATBOT_PORT=8001
